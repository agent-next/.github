{
  "id": 101,
  "name": "agent-fence",
  "target": "branch",
  "source_type": "Repository",
  "source": "agent-next/agent-ready",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "refs/heads/sbx/**",
        "refs/heads/sbx/**/*",
        "refs/heads/dependabot/**",
        "refs/heads/bot/**",
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "dismissal_restriction": {
          "enabled": false,
          "allowed_actors": []
        },
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    }
  ],
  "node_id": "ANON",
  "created_at": "2026-01-23T18:10:55.118Z",
  "updated_at": "2026-09-23T12:25:26.838Z",
  "current_user_can_bypass": "never",
  "_links": {
    "self": {
      "href": "https://api.github.com/repos/agent-next/agent-ready/rulesets/101"
    },
    "html": {
      "href": "https://github.com/agent-next/agent-ready/rules/101"
    }
  },
  "bypass_actors": [
    {
      "actor_id": 7,
      "actor_type": "Integration",
      "bypass_mode": "always"
    }
  ]
}
